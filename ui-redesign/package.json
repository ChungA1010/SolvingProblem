{
  "name": "cmp-lab-ui-concept",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:scene && tailwindcss -i ./src/input.css -o ./dist/styles.css --minify",
    "build:scene": "esbuild src/cmp-scene.js --bundle --format=iife --global-name=CMPScene --target=es2020 --loader:.glb=base64 --minify --legal-comments=eof --outfile=dist/cmp-scene.js",
    "preview": "node server.mjs",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
