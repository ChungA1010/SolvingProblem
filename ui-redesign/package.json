{
  "name": "cmp-lab-ui-concept",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:scene && node tools/build-scenes.mjs && tailwindcss -i ./shared/src/input.css -o ./shared/styles.css --minify",
    "build:scene": "esbuild factory/src/cmp-scene.js --bundle --format=iife --global-name=CMPScene --target=es2020 --loader:.glb=base64 --minify --legal-comments=eof --outfile=factory/cmp-scene.js",
    "build:lab3d": "node tools/build-scenes.mjs lab-3d",
    "build:process-lab": "node tools/build-scenes.mjs process-lab",
    "standalone": "node tools/build-standalone.mjs",
    "export": "node tools/export-site.mjs",
    "preview": "node server.mjs",
    "test": "node --test \"*/tests/*.test.cjs\" \"tests/*.test.cjs\"",
    "check:browser": "node tools/check-browser.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
